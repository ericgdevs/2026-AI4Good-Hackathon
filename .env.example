# Copy to .env (gitignored) and fill in. Paths must be outside the repo.
DATA_DIR=/absolute/path/outside/repo/videos
OUTPUT_DIR=/absolute/path/outside/repo/outputs

# UNF HPC, used by scripts/sync_code_to_hpc.sh and scripts/sync_outputs_from_hpc.sh
HPC_USER=your-unf-username
HPC_HOST=hpc-login.example.edu
HPC_OUTPUT_DIR=/path/on/hpc/outputs
# HPC_REPO_DIR=~/tpa-work/repo   # optional; where sync_code_to_hpc.sh puts the repo
